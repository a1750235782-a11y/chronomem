# Configuration reference only. No real secret belongs in this file.
# For local setup, run setup_local_key.py; it creates .env for you.
# For deployment, set CHRONOMEM_API_KEY to a newly generated random secret.
CHRONOMEM_API_KEY=

# Optional. The default SQLite file is next to the app.
# On Render, render.yaml sets this to the persistent disk mount.
# CHRONOMEM_DB_PATH=/var/data/chronomem_contract.db
# CHRONOMEM_VERSION=0.2.0-keyword
